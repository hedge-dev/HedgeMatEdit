<UserControl 
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:editors="using:HedgeDev.Editor.Material.Views.Editors"
    xmlns:resource="using:HedgeDev.Editor.Material.ViewModels.Resource"
	xmlns:conv="using:Avalonia.Data.Converters"
	xmlns:jconv="using:J113D.Avalonia.Converters"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
	xmlns:vm="using:HedgeDev.Editor.Material.ViewModels"
	x:Class="HedgeDev.Editor.Material.Views.Editors.UcMaterialsEditor"
	x:ClassModifier="internal"
	x:DataType="vm:MainViewModel"
	x:Name="MaterialsEditor">

  <UserControl.Resources>
	<jconv:EmptyStringToNullConverter x:Key="EmptyStringToNullConverter"/>
  </UserControl.Resources>

  <Panel
		DragDrop.AllowDrop="True"
		DragDrop.DragEnter="OnDragEnter"
		DragDrop.DragLeave="OnDragLeave"
		DragDrop.Drop="OnDrop">

		<Grid ColumnDefinitions="*,6,2*">

			<DockPanel Grid.Column="0" >

				<Border DockPanel.Dock="Top" Margin="0 0 0 6">
					<TextBox 
						Watermark="Find..."
						Text="{Binding Materials.FilterValue, Converter={StaticResource EmptyStringToNullConverter}}"
						x:Name="SearchTextBox">
						<TextBox.KeyBindings>
							<KeyBinding Gesture="Escape" Command="{Binding ClearFilterCommand}"/>
						</TextBox.KeyBindings>
					</TextBox>
				</Border>
				
				<ListBox 
					CornerRadius="3"
					Background="{DynamicResource BackgroundColor4}"
					ItemsSource="{Binding Materials}"
					SelectedItem="{Binding SelectedMaterial}"
					ScrollViewer.AllowAutoHide="False"
					ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
					ScrollViewer.VerticalScrollBarVisibility="Auto">

					<ListBox.Styles>
						<Style Selector="ListBoxItem" x:DataType="{x:Type resource:MaterialViewModel}">
							<Setter Property="Padding" Value="6,3,6,6"/>
							<Setter Property="CornerRadius" Value="3"/>
						</Style>
					</ListBox.Styles>
				
					<ListBox.ItemTemplate>
						<DataTemplate DataType="{x:Type resource:MaterialViewModel}">
							<DockPanel>
								<TextBlock Text="{Binding Name}"/>
								<TextBlock DockPanel.Dock="Right" Text="*" IsVisible="{Binding HasDataChanged}"/>
							</DockPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>

				</ListBox>
			</DockPanel>


			<GridSplitter Grid.Column="1" Background="Transparent"/>

			<Panel Grid.Column="2" DataContext="{Binding ActiveMaterial}">

				<Border
					IsVisible="{Binding Converter={x:Static conv:ObjectConverters.IsNull}}">
					<TextBlock 
						VerticalAlignment="Center"
						HorizontalAlignment="Center"
						Text="No material open" 
						FontWeight="SemiBold"
						Foreground="{DynamicResource ForegroundColor3}"/>
				</Border>

				<editors:UcMaterialEditor 
					IsVisible="{Binding Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
			</Panel>


		</Grid>


		<Panel Name="DropOverlay" IsVisible="False">

			<Border
				CornerRadius="3"
				Opacity="0.2"
				Background="{DynamicResource HighlightedAccentColor}"/>

			<Border
				Background="{DynamicResource BackgroundColor4}"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				CornerRadius="6">

				<TextBlock
					Text="Drop file to load/import"
					FontWeight="Bold"
					Padding="8"/>
			</Border>


		</Panel>
				
	</Panel>
</UserControl>
