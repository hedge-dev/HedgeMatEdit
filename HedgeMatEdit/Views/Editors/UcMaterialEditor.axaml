<UserControl 
	xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:HedgeDev.Editor.Material.ViewModels.Resource"
	xmlns:view="using:HedgeDev.Editor.Material.Views"
	xmlns:editor="using:HedgeDev.Editor.Material.Views.Editors"
	xmlns:enumUtil="using:J113D.Avalonia.Utilities.Enum"
    mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
    x:Class="HedgeDev.Editor.Material.Views.Editors.UcMaterialEditor"
	x:DataType="vm:MaterialViewModel">

	<ScrollViewer 
		x:Name="ScrollPanel"
		HorizontalScrollBarVisibility="Disabled" 
		VerticalScrollBarVisibility="Auto"
		AllowAutoHide="False"
		SizeChanged="OnScrollViewerSizeChanged">
		
		<StackPanel 
			Spacing="6">

			<editor:UcMatEditGeneral/>
			
			<editor:UcMatEditTextures
				DataContext="{Binding TextureSet}"/>

			<editor:UcMatEditFloatParameters
				DataContext="{Binding FloatParameters}"/>

			<editor:UcMatEditIntParameters
				Name="IntParameters"
				DataContext="{Binding IntParameters}"/>

			<editor:UcMatEditBoolParameters
				DataContext="{Binding BoolParameters}"/>

			<Panel IsVisible="{Binding  ShowSCAParameters}">
				<editor:UcMatEditSCAParameters DataContext="{Binding SCAParameters}"/>
			</Panel>

			
		</StackPanel>
		
	</ScrollViewer>
	
</UserControl>
