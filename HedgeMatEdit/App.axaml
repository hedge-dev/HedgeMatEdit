<Application 
	xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:j113da="using:J113D.Avalonia.Theme"
    x:Class="HedgeDev.Editor.Material.App"
	x:ClassModifier="internal"
	xmlns:enumUtil="using:J113D.Avalonia.Utilities.Enum"
    RequestedThemeVariant="Default">

	<Application.Resources>
		<x:Double x:Key="AppFontSize">14</x:Double>
		<x:Double x:Key="AppFontSizeH1">16</x:Double>
		<enumUtil:EnumDescriptionConverter x:Key="EnumConv"/>
	</Application.Resources>

	<Application.Styles>
        <j113da:J113DTheme />
		
		<Style Selector="Window">
			<Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
		</Style>

		<Style Selector="TextBox.HeaderFont">
			<Setter Property="FontSize" Value="{DynamicResource AppFontSizeH1}"/>
		</Style>
	</Application.Styles>

</Application>